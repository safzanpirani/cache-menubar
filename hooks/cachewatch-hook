#!/bin/sh
# cachewatch-hook <claude|codex>
# Claude Code / Codex CLI hook (UserPromptSubmit, Stop, SessionEnd). Records, per session, when the last turn ended and
# what the prompt cache looked like, into ~/.local/state/cachewatch/<agent>-<session>.json. CacheMenuBar reads that
# directory locally and over ssh on remote hosts. Portable: POSIX sh + python3, no other dependencies.
set -u
agent="${1:-claude}"
dir="${CACHEWATCH_DIR:-$HOME/.local/state/cachewatch}"
mkdir -p "$dir" 2>/dev/null || exit 0
command -v python3 >/dev/null 2>&1 || exit 0
# The hook payload arrives on stdin; stash it in a file because the python script itself is fed through stdin.
inp="$(mktemp "${TMPDIR:-/tmp}/cachewatch.XXXXXX")" || exit 0
trap 'rm -f "$inp"' EXIT HUP INT TERM
cat >"$inp" 2>/dev/null || true
CW_AGENT="$agent" CW_DIR="$dir" CW_PANE="${HERDR_PANE_ID:-}" CW_INPUT="$inp" python3 - <<'PY'
import json, os, sys, time, socket, tempfile, fcntl

agent = os.environ["CW_AGENT"]; d = os.environ["CW_DIR"]
if agent not in ("claude", "codex"): sys.exit(0)
try: hook = json.load(open(os.environ["CW_INPUT"]))
except Exception: hook = {}
if not isinstance(hook, dict): sys.exit(0)
sid = hook.get("session_id") or hook.get("thread_id") or ""
ev = hook.get("hook_event_name") or hook.get("event") or ""
if not isinstance(sid, str) or not sid or any(c not in "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-_" for c in sid) or not ev: sys.exit(0)
path = os.path.join(d, f"{agent}-{sid}.json")
# Serialize the read/modify/replace lifecycle, including SessionEnd. This lock
# file stays in place so waiters always synchronize on the same inode.
lock_fd = os.open(os.path.join(d, ".lock"), os.O_CREAT | os.O_RDWR, 0o600)
fcntl.flock(lock_fd, fcntl.LOCK_EX)
now = int(time.time())

# prune stale records (6h) so the directory never grows unbounded
try:
    for f in os.listdir(d):
        p = os.path.join(d, f)
        if f.endswith(".json") and now - os.path.getmtime(p) > 6 * 3600: os.remove(p)
except Exception: pass

if ev == "SessionEnd":
    try: os.remove(path)
    except Exception: pass
    sys.exit(0)

try: st = json.load(open(path))
except Exception: st = {}
if not isinstance(st, dict): st = {}
st.update({"agent": agent, "session_id": sid, "host": socket.gethostname().split(".")[0], "cwd": hook.get("cwd") or st.get("cwd") or ""})
if os.environ.get("CW_PANE"): st["pane_id"] = os.environ["CW_PANE"]
if isinstance(hook.get("model"), str) and hook["model"]: st["model"] = hook["model"]
if not st.get("title"): st["title"] = os.path.basename(st["cwd"].rstrip("/")) or st["cwd"]

if ev == "UserPromptSubmit":
    st["active"] = True; st["prompt_at"] = now
    p = hook.get("prompt")
    p = p.strip().replace("\n", " ") if isinstance(p, str) else ""
    if p: st["last_prompt"] = p[:80]
elif ev == "Stop":
    st["active"] = False; st["at"] = now
    # Cache shape from the transcript. Claude Code writes 5m cache entries when authenticated with an API key and 1h
    # entries on a subscription, so the TTL of the last turn that wrote to the cache tells us both the TTL and the auth
    # mode. Tokens come from the very last usage block (a pure read still tells the prefix size).
    tp = hook.get("transcript_path")
    if agent == "codex" and not (tp and os.path.isfile(tp)):
        # Codex rollouts: ~/.codex/sessions/YYYY/MM/DD/rollout-<ts>-<thread_id>.jsonl
        import glob
        codex_home = os.environ.get("CODEX_HOME") or os.path.expanduser("~/.codex")
        c = sorted(glob.glob(os.path.join(glob.escape(codex_home), f"sessions/*/*/*/rollout-*-{sid}.jsonl")), key=os.path.getmtime)
        tp = c[-1] if c else None
    usage = None; wrote = None; model = hook.get("model")
    if tp and os.path.isfile(tp):
        try:
            with open(tp, "rb") as fh:
                fh.seek(0, 2); size = fh.tell(); fh.seek(max(0, size - 512 * 1024)); tail = fh.read().decode("utf-8", "ignore")
            for line in reversed(tail.splitlines()):
                try: o = json.loads(line)
                except Exception: continue
                if not isinstance(o, dict): continue
                m = o.get("message") if isinstance(o.get("message"), dict) else o.get("payload") if isinstance(o.get("payload"), dict) else o
                if model is None and o.get("type") == "turn_context" and isinstance(m, dict) and isinstance(m.get("model"), str): model = m["model"]
                u = m.get("usage") if isinstance(m, dict) else None
                if agent == "codex" and m.get("type") == "token_count":
                    info = m.get("info")
                    u = info.get("last_token_usage") if isinstance(info, dict) else None
                if not (isinstance(u, dict) and ("cache_read_input_tokens" in u or "input_tokens" in u)): continue
                if usage is None: usage = u; model = model or m.get("model") or o.get("model")
                if agent == "codex" and model: break
                cc = u.get("cache_creation")
                cc = cc if isinstance(cc, dict) else {}
                if (cc.get("ephemeral_1h_input_tokens") or 0) > 0 or (cc.get("ephemeral_5m_input_tokens") or 0) > 0 or (u.get("cache_creation_input_tokens") or 0) > 0:
                    wrote = u; break
        except Exception: pass
    if agent == "codex" or (usage is None and agent != "claude"):
        st["ttl"] = "openai"
    def tokens(value):
        return value if isinstance(value, int) and not isinstance(value, bool) and value >= 0 else 0
    if usage:
        cc = usage.get("cache_creation")
        cc = cc if isinstance(cc, dict) else {}
        w1h = tokens(cc.get("ephemeral_1h_input_tokens"))
        # The aggregate includes both TTL buckets. Do not count the one-hour
        # writes again as five-minute writes when detailed buckets are present.
        if any(key in cc for key in ("ephemeral_1h_input_tokens", "ephemeral_5m_input_tokens")):
            w5 = tokens(cc.get("ephemeral_5m_input_tokens"))
        else:
            w5 = tokens(usage.get("cache_creation_input_tokens")) or tokens(usage.get("cache_write_input_tokens"))
        details = usage.get("input_tokens_details")
        details = details if isinstance(details, dict) else {}
        read = tokens(usage.get("cache_read_input_tokens")) or tokens(usage.get("cached_input_tokens")) or tokens(details.get("cached_tokens"))
        st["tokens"] = read + w1h + w5
    if model: st["model"] = model
    if agent == "claude" and wrote:
        creation = wrote.get("cache_creation")
        w1h = tokens(creation.get("ephemeral_1h_input_tokens")) if isinstance(creation, dict) else 0
        st["ttl"] = "1h" if w1h > 0 else "5m"
        st["auth"] = "subscription" if w1h > 0 else "api"
    st.setdefault("ttl", "5m" if agent == "claude" else "openai")
    st.setdefault("tokens", 0)
else:
    sys.exit(0)

fd, tmp = tempfile.mkstemp(prefix=".record-", dir=d)
try:
    with os.fdopen(fd, "w") as fh:
        json.dump(st, fh)
        fh.flush()
        os.fsync(fh.fileno())
    os.replace(tmp, path)
finally:
    try: os.unlink(tmp)
    except FileNotFoundError: pass
PY
exit 0
